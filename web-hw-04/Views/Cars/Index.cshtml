@model List<car>
<h1>Available Cars</h1>
<p></p>
@if (Model.Count > 0)
{
    <div class="container ">
        <div class="d-grid">
            @foreach (var c in Model)
            {
                <div class="row card shadow-sm p-3 h-100 ">
                    <div class="col card-body">
                        <h2 class="card-title">Car Name : @c.Name</h2>
                        <p class="card-text">Per day Price : rs.@c.PricePerDay</p>
                        <span class="badge bg-success">Available</span>
                        <form method="post" action="/Cars/Book">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-primary w-100">Book Car</button>

                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        No cars available for booking.
    </div>
}
</html>