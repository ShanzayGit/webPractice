@model List<car>
<button type="button" class="btn btn-secondary" onclick="window.location.href='/Cars/Booked'">Booked Cars</button>
<button type="button" class="btn btn-secondary" onclick="window.location.href='/Cars/Index'">Back to Cars</button>
@if (Model.Count > 0)
{
    <table class="table table-striped table-hover ">
        <thead>
            <tr class="table-dark">
                <th>ID</th>
                <th>Car Name</th>
                <th>PricePerDay</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (car c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.PricePerDay</td>
                    <td class="badge bg-warning text-dark">Booked</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No cars booked</div>
}

